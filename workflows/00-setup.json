          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "5291adde-9f67-f607-cce7-acfbfe197b8f",
      "name": "Save settings",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1540,
        -120
      ]
    },
    {
      "parameters": {
        "jsCode": "// SAMPLE price book for the demo. These are illustrative numbers, not market prices.\n// After setup, edit them in the garage_price_book data table.\nconst rows = [\n  ['oil_service', 'Oil and filter service', 'oil change, service, λάδια, σέρβις', 0.8, 45, 90, true],\n  ['brake_pads_front', 'Front brake pads', 'front pads, τακάκια εμπρός', 1.0, 40, 120, true],\n  ['brake_pads_rear', 'Rear brake pads', 'rear pads, τακάκια πίσω', 1.0, 35, 110, true],\n  ['brake_discs_pads_front', 'Front brake discs and pads', 'discs, rotors, δισκόπλακες', 1.5, 120, 300, true],\n  ['battery', 'Battery replacement', 'battery, won\\'t start, μπαταρία', 0.3, 80, 180, true],\n  ['ac_recharge', 'Air-con recharge', 'A/C, aircon, κλιματισμός, air condition', 0.8, 30, 60, true],\n  ['spark_plugs', 'Spark plugs', 'plugs, μπουζί', 0.8, 30, 90, true],\n  ['tyre_fit_balance', 'Fit and balance 4 tyres (tyres not included)', 'tyres, tires, λάστιχα, ελαστικά, balancing', 0.8, 0, 0, true],\n  ['diagnostic_scan', 'Diagnostic scan', 'check engine, warning light, diagnosis, διάγνωση', 0.5, 0, 0, true],\n  ['inspection_prep', 'Pre-inspection check (KTEO)', 'KTEO, ΚΤΕΟ, MOT, inspection', 1.0, 0, 0, true],\n  ['timing_belt', 'Timing belt kit and water pump', 'timing belt, cambelt, ιμάντας χρονισμού', 3.5, 150, 400, false],\n  ['clutch', 'Clutch replacement', 'clutch, συμπλέκτης', 5.0, 250, 600, false],\n];\nreturn rows.map(([job_code, name, keywords, labour_hours, parts_low_eur, parts_high_eur, auto_quote]) => ({ json: {\n  job_code, name, keywords, labour_hours, parts_low_eur, parts_high_eur, auto_quote,\n  notes: 'SAMPLE value – replace with your own',\n} }));"
      },
      "id": "5423063c-8cac-2858-2e4b-580b7223249e",
      "name": "Sample price book",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
