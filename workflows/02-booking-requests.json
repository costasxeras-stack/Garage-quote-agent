{
  "name": "Garage Quote Agent · 02 Booking requests",
  "nodes": [
    {
      "parameters": {
        "content": "## 02 · Booking requests\nEvery estimate links to this form. The link carries the lead ID and a one-time token, so a booking is only accepted for a real, open estimate.\n\nThe owner gets the booking request on WhatsApp and confirms the time with the customer.\n\nCopy this form's **Production URL** into `booking_form_url` in the **garage_settings** table.",
        "width": 440,
        "height": 240,
        "color": 4
      },
      "id": "171c6ea3-9db5-0693-1650-5d7225c6437d",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -340
      ]
    },
    {
      "parameters": {
        "formTitle": "Book your repair",
        "formDescription": "Choose a day and time that suit you. We will confirm by phone or message.",
        "formFields": {
          "values": [
            {
              "fieldName": "lead_id",
              "fieldType": "hiddenField"
            },
            {
              "fieldName": "token",
              "fieldType": "hiddenField"
            },
            {
              "fieldName": "preferred_date",
              "fieldLabel": "Preferred day",
              "fieldType": "date",
              "requiredField": true
            },
            {
              "fieldName": "preferred_time",
              "fieldLabel": "Preferred time",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Morning (08:00–12:00)"
                  },
                  {
                    "option": "Midday (12:00–15:00)"
                  },
                  {
                    "option": "Afternoon (15:00–18:00)"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldName": "note",
              "fieldLabel": "Anything else we should know?",
              "fieldType": "textarea"
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "path": "garage-booking",
          "appendAttribution": false,
          "buttonLabel": "Request this time",
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "Thank you. We have your request and will confirm the time shortly."
            }
          }
        }
      },
