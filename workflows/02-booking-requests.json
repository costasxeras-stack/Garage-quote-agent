      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "cl1",
              "name": "valid",
              "value": "={{ !!$json.lead_id && $json.token === String($('Booking form').first().json.token ?? '') && ['quoted', 'needs_call', 'awaiting_owner'].includes($json.status) }}",
              "type": "boolean"
            },
            {
              "id": "cl2",
              "name": "reason",
              "value": "={{ !$json.lead_id ? 'lead not found' : ($json.token === String($('Booking form').first().json.token ?? '') && ['quoted', 'needs_call', 'awaiting_owner'].includes($json.status) ? '' : 'token mismatch or lead closed (' + $json.status + ')') }}",
              "type": "string"
            },
            {
              "id": "cl3",
              "name": "lead_id",
              "value": "={{ $json.lead_id || String($('Booking form').first().json.lead_id ?? '') }}",
              "type": "string"
            },
            {
              "id": "cl4",
              "name": "customer_name",
              "value": "={{ $json.customer_name ?? '' }}",
              "type": "string"
            },
            {
              "id": "cl5",
              "name": "customer_phone",
              "value": "={{ $json.customer_phone ?? '' }}",
              "type": "string"
            },
            {
              "id": "cl6",
              "name": "customer_email",
              "value": "={{ $json.customer_email ?? '' }}",
              "type": "string"
            },
            {
              "id": "cl7",
              "name": "car",
              "value": "={{ $json.lead_id ? [$json.car_make, $json.car_model, $json.car_year || ''].filter(Boolean).join(' ') : '' }}",
              "type": "string"
            },
            {
              "id": "cl8",
              "name": "estimate",
              "value": "={{ $json.lead_id ? '€' + $json.quote_low + ' – €' + $json.quote_high : '' }}",
              "type": "string"
            },
            {
              "id": "cl9",
              "name": "booking_pref",
              "value": "={{ String($('Booking form').first().json.preferred_date ?? '').slice(0, 10) + ', ' + ($('Booking form').first().json.preferred_time ?? '') + ($('Booking form').first().json.note ? ' – ' + $('Booking form').first().json.note : '') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
