      "id": "5b6a9f89-3734-81d0-fb01-4b673b9259ae",
      "name": "Leads due a follow-up",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Picks the right follow-up for each lead that is due one.\nconst s = $('Load settings').first().json;\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  if (!j.lead_id) continue;\n  const via = j.channel === 'whatsapp' ? 'whatsapp' : (j.customer_email ? 'email' : 'none');\n  const stage = Number(j.followup_stage) || 0;\n  const first = (j.customer_name || '').split(' ')[0];\n  const hi = 'Hi' + (first ? ' ' + first : '') + ',';\n  const car = [j.car_make, j.car_model].filter(Boolean).join(' ');\n  const maxStage = via === 'whatsapp' ? 1 : 2; // after 24h WhatsApp needs approved templates (not in v0.1)\n\n  if (stage >= maxStage || via === 'none') {\n    out.push({ json: { ...j, reply_via: 'none', reply_text: '', new_status: 'lost_no_reply', new_stage: stage, next_followup_at: null } });\n  } else if (stage === 0) {\n    out.push({ json: { ...j, reply_via: via, new_status: 'quoted', new_stage: 1,\n      reply_subject: 'Shall we book your ' + (car || 'car') + ' in?',\n      reply_text: [hi, '', 'Just checking: would you like to book a time for your ' + (car || 'car') + '? Your estimate was €' + j.quote_low + ' – €' + j.quote_high + '.', '', 'Book here: ' + s.booking_form_url + '?lead_id=' + j.lead_id + '&token=' + j.token, 'Or reply with any questions.', '', s.garage_name].join('\\n'),\n      next_followup_at: via === 'email' ? new Date(Date.now() + (Number(s.final_followup_days) || 3) * 86400e3).toISOString() : new Date(Date.now() + 3600e3).toISOString() } });\n  } else {\n    out.push({ json: { ...j, reply_via: via, new_status: 'quoted', new_stage: 2,\n      reply_subject: 'Your estimate from ' + s.garage_name,\n      reply_text: [hi, '', 'Your estimate for the ' + (car || 'car') + ' is still valid. If you would like to book or have questions, just reply or call us on ' + s.garage_phone + '. We will not send more reminders about this request.', '', s.garage_name].join('\\n'),\n      next_followup_at: new Date(Date.now() + 86400e3).toISOString() } });\n  }\n}\nreturn out;"
      },
