    {
      "name": "Work out next step",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "ws1",
              "name": "via",
              "value": "={{ ($json.channel === 'whatsapp' ? 'whatsapp' : ($json.customer_email ? 'email' : 'none')) }}",
              "type": "string"
            },
            {
              "id": "ws2",
              "name": "stage",
              "value": "={{ Number($json.followup_stage) || 0 }}",
              "type": "number"
            },
            {
              "id": "ws3",
              "name": "step",
              "value": "={{ (Number($json.followup_stage) || 0) >= ($json.channel === 'whatsapp' ? 1 : 2) || ($json.channel === 'whatsapp' ? 'whatsapp' : ($json.customer_email ? 'email' : 'none')) === 'none' ? 'give_up' : (Number($json.followup_stage) || 0) === 0 ? 'first_reminder' : 'last_reminder' }}",
              "type": "string"
            },
            {
              "id": "ws4",
              "name": "greeting",
              "value": "={{ 'Hi' + (String($json.customer_name || '').split(' ')[0] ? ' ' + String($json.customer_name || '').split(' ')[0] : '') + ',' }}",
              "type": "string"
            },
            {
              "id": "ws5",
              "name": "car",
              "value": "={{ [$json.car_make, $json.car_model].filter(Boolean).join(' ') || 'car' }}",
              "type": "string"
            }
          ]
        },
        "options": {},
        "includeOtherFields": true,
        "include": "all"
      },
      "id": "b0d3011e-278d-45f5-bab8-f1e199e57fc3"
    },
    {
      "name": "Choose follow-up",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "cf1",
              "name": "reply_via",
              "value": "={{ $json.step === 'give_up' ? 'none' : $json.via }}",
              "type": "string"
            },
            {
              "id": "cf2",
              "name": "new_status",
              "value": "={{ $json.step === 'give_up' ? 'lost_no_reply' : 'quoted' }}",
              "type": "string"
            },
            {
              "id": "cf3",
              "name": "new_stage",
              "value": "={{ $json.step === 'give_up' ? $json.stage : $json.step === 'first_reminder' ? 1 : 2 }}",
              "type": "number"
            },
            {
              "id": "cf4",
              "name": "reply_subject",
              "value": "={{ $json.step === 'first_reminder' ? 'Shall we book your ' + $json.car + ' in?' : $json.step === 'last_reminder' ? 'Your estimate from ' + $('Load settings').first().json.garage_name : '' }}",
              "type": "string"
            },
            {
              "id": "cf5",
              "name": "reply_text",
              "value": "={{ $json.step === 'first_reminder' ? $json.greeting + '\\n\\nJust checking: would you like to book a time for your ' + $json.car + '? Your estimate was €' + $json.quote_low + ' – €' + $json.quote_high + '.\\n\\nBook here: ' + $('Load settings').first().json.booking_form_url + '?lead_id=' + $json.lead_id + '&token=' + $json.token + '\\nOr reply with any questions.\\n\\n' + $('Load settings').first().json.garage_name : $json.step === 'last_reminder' ? $json.greeting + '\\n\\nYour estimate for the ' + $json.car + ' is still valid. If you would like to book or have questions, just reply or call us on ' + $('Load settings').first().json.garage_phone + '. We will not send more reminders about this request.\\n\\n' + $('Load settings').first().json.garage_name : '' }}",
              "type": "string"
            },
            {
              "id": "cf6",
              "name": "next_followup_at",
              "value": "={{ $json.step === 'give_up' ? '' : $json.step === 'first_reminder' ? ($json.via === 'email' ? $now.plus({ days: Number($('Load settings').first().json.final_followup_days) || 3 }) : $now.plus({ hours: 1 })).toUTC().toISO() : $now.plus({ days: 1 }).toUTC().toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {},
        "includeOtherFields": true,
        "include": "all"
      },
      "id": "9a344e94-6d2a-4bd7-8725-38b55807df25"
    },
